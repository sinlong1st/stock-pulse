# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development
LOG_LEVEL=INFO
# Your local timezone — used everywhere a local time matters
# (quiet hours, the daily digest). One setting for the whole app.
TIMEZONE=Asia/Ho_Chi_Minh

# Database (Phase 2+)
DATABASE_URL=sqlite:///./stockpulse.db

# News monitoring (Phase 7+)
# Separate fetch cadences for each source (minutes).
WATCHLIST_FETCH_INTERVAL_MINUTES=5
MACRO_FETCH_INTERVAL_MINUTES=30
# Set to true to run the pipeline automatically on the intervals above.
# WARNING: when enabled it spends OpenAI credit and sends Telegram
# messages on its own. Leave false to run only via the /run endpoint.
SCHEDULER_ENABLED=false
MAX_CLASSIFICATIONS_PER_RUN=5
MAX_ALERTS_PER_RUN=20

# AI classifier (Phase 4+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Default language for AI summaries + alerts, e.g. English, Vietnamese, Spanish.
# The /language Telegram command (en/vi) overrides this at runtime; the choice
# is saved to PREFS_FILE (runtime_prefs.json) and survives restarts.
OUTPUT_LANGUAGE=English

# Alerting (Phase 5+). Minimum importance that triggers an alert:
# LOW / MEDIUM / HIGH / CRITICAL.
ALERT_MIN_IMPORTANCE=MEDIUM
# Include the article URL in the alert message (true/false).
ALERT_INCLUDE_LINK=true
# Show Telegram's link preview/thumbnail (false keeps messages short).
ALERT_LINK_PREVIEW=false

# Quiet hours — hold non-urgent alerts during your sleep window (local time).
# Held alerts stay pending and are delivered after the window ends.
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
QUIET_HOURS_MIN_IMPORTANCE=CRITICAL   # this level and above always sends

# Telegram notifications (Phase 6+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Price data (Alpaca Market Data API — free IEX feed; paper keys work too).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets/v2
PRICE_FEATURES_ENABLED=false
# Add a "MU +3.4% today" line to alerts (needs PRICE_FEATURES_ENABLED too).
PRICE_CONTEXT_IN_ALERTS=false

# Earnings calendar + last-quarter EPS in the report and prediction.
# Keyless (Yahoo quoteSummary, cookie+crumb handshake). Best-effort: if Yahoo
# changes or rate-limits, the earnings section just hides — nothing else breaks.
EARNINGS_ENABLED=true
EARNINGS_CACHE_HOURS=6           # earnings move quarterly, not intraday
EARNINGS_MAX_TICKERS=15          # cap the fan-out on a big watchlist

# Self-evaluation — record AI predictions and score them vs price later.
# Needs PRICE_FEATURES_ENABLED (uses Alpaca).
EVALUATION_ENABLED=false
EVALUATION_HORIZONS=1d           # comma-separated, e.g. 1h,1d
# Moves within ±this % count as "flat" (tolerance band).
EVALUATION_MOVE_THRESHOLD_PCT=0.5
# Moves bigger than this % are treated as bad data and skipped.
EVALUATION_MAX_MOVE_PCT=40
EVALUATION_CHECK_INTERVAL_MINUTES=15
# Daily self-evaluation summary to Telegram (the hour is in TIMEZONE above).
EVALUATION_DIGEST_ENABLED=false
EVALUATION_DIGEST_HOUR=8

# Market Briefing ("the secretary") — a proactive analyst that pulls the
# latest news on a schedule (and on demand via the /report Telegram command)
# and reports what matters for your watchlist. Separate from alerts.
BRIEFING_ENABLED=false
# Runs on US-market / your local (Pacific) time — independent of TIMEZONE above.
BRIEFING_TIMEZONE=America/Los_Angeles
BRIEFING_SCHEDULE_DAYS=mon-fri
BRIEFING_MORNING_AT=08:30            # full morning brief
BRIEFING_INTRADAY_EVERY_HOURS=2     # updates at 10:30, 12:30, 14:30, 16:30
BRIEFING_INTRADAY_UNTIL=16:30       # last intraday check-in
BRIEFING_WRAP_AT=18:00              # end-of-day recap
# Look-back windows (hours): wide overnight catch-up for the morning brief,
# short "what's fresh now" for intraday + on-demand.
BRIEFING_MORNING_WINDOW_HOURS=16
BRIEFING_INTRADAY_WINDOW_HOURS=2
BRIEFING_ONDEMAND_WINDOW_HOURS=2
BRIEFING_MODEL=gpt-4o-mini          # override to a web-search-capable model when enabled
BRIEFING_WEB_SEARCH_ENABLED=false   # (not wired yet) let the model pull news itself
BRIEFING_MEMORY_HOURS=3             # how far back trend context reaches
BRIEFING_MAX_ITEMS=40              # cap news items sent to the model (cost)
# Show open + current price (with a freshness label + report timestamp) in
# briefings. Needs PRICE_FEATURES_ENABLED + Alpaca keys below.
BRIEFING_PRICES_IN_REPORT=true
BRIEFING_PRICE_MAX_TICKERS=12
# Price source for the report: "yahoo" (free, keyless, consolidated +
# pre/post-market — closest to a phone stocks app) or "alpaca" (free IEX feed).
# Self-evaluation always uses Alpaca regardless of this.
BRIEFING_PRICE_SOURCE=yahoo
# Flag a watchlist stock that moved at least this % today even without news.
BRIEFING_PRICE_MOVE_THRESHOLD_PCT=3.0
# On-demand /report Telegram command (needs Telegram creds above).
BRIEFING_COMMAND_ENABLED=false
BRIEFING_COMMAND=/report

# Watchlist config file (tickers + company aliases).
# Copy watchlist.example.json to watchlist.json and edit that file.
WATCHLIST_FILE=watchlist.json

# Keyword config file (macro + sector keywords).
# Copy keywords.example.json to keywords.json and edit that file.
KEYWORDS_FILE=keywords.json

# Read-only JSON API for the mobile app (GET /api/feed). Off by default.
# When on, requests must send `Authorization: Bearer <MOBILE_API_TOKEN>`.
# Additive + read-only — it does not affect alerts or Telegram. Set a long
# random token (e.g. `openssl rand -hex 24`) if you expose this to the internet.
MOBILE_API_ENABLED=false
MOBILE_API_TOKEN=

# Push notifications (Expo Push API). The /api/push register + test endpoints
# work whenever the mobile API is on; PUSH_ENABLED gates sending pushes in the
# alert flow (wired later). EXPO_ACCESS_TOKEN is optional (enhanced security).
PUSH_ENABLED=false
PUSH_TOKENS_FILE=push_tokens.json
EXPO_ACCESS_TOKEN=

# AI prediction (forward-looking, on-demand — GET /api/predict). Off by default;
# each call is one OpenAI request. See specs/STOCKPULSE_AI_PREDICTION_PLAN.md.
PREDICTION_ENABLED=false
PREDICTION_HORIZONS=1w,1mo,3mo
PREDICTION_MODEL=gpt-4o-mini
PREDICTION_RANGE_MONTHS=6
