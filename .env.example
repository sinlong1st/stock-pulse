# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (Phase 2+)
DATABASE_URL=sqlite:///./stockpulse.db

# News monitoring (Phase 7+)
NEWS_CHECK_INTERVAL_MINUTES=10
# Set to true to run the pipeline automatically on the interval above.
# WARNING: when enabled it spends OpenAI credit and sends Telegram
# messages on its own. Leave false to run only via the /run endpoint.
SCHEDULER_ENABLED=false
MAX_CLASSIFICATIONS_PER_RUN=5
MAX_ALERTS_PER_RUN=20

# AI classifier (Phase 4+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Language for AI summaries + alerts, e.g. English, Vietnamese, Spanish.
OUTPUT_LANGUAGE=English

# Alerting (Phase 5+). Minimum importance that triggers an alert:
# LOW / MEDIUM / HIGH / CRITICAL.
ALERT_MIN_IMPORTANCE=MEDIUM

# Telegram notifications (Phase 6+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Watchlist config file (tickers + company aliases).
# Copy watchlist.example.json to watchlist.json and edit that file.
WATCHLIST_FILE=watchlist.json

# Keyword config file (macro + sector keywords).
# Copy keywords.example.json to keywords.json and edit that file.
KEYWORDS_FILE=keywords.json
