# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (Phase 2+)
DATABASE_URL=sqlite:///./stockpulse.db

# News monitoring (Phase 7+)
NEWS_CHECK_INTERVAL_MINUTES=10

# AI classifier (Phase 4+)
OPENAI_API_KEY=

# Telegram notifications (Phase 6+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Watchlist (comma-separated tickers)
WATCHLIST=QQQ,QQQM,VOO,NVDA,AMD,PLTR,SOFI,HOOD,META,AMZN
