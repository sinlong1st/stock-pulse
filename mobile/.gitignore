.env
.env*.local

# Firebase config — kept out of this PUBLIC repo. For EAS cloud builds it's
# supplied via the GOOGLE_SERVICES_JSON file env var (see app.config.js).
google-services.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
