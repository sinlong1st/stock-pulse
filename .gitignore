# Local config files (edit the .json; commit the .example.json templates).
# Anchored to the repo root on purpose: unanchored, these match at ANY depth and
# silently swallowed tests/fixtures/watchlist.json, which must be committed for
# CI to pass. Docker mounts both from the root (see docker-compose.yml).
/watchlist.json
/keywords.json

# Briefing rolling theme memory (runtime state, not config)
briefing_memory.json

# Runtime user prefs, e.g. the /language choice (runtime state, not config)
runtime_prefs.json

# Registered push notification tokens (runtime state, not config)
push_tokens.json

# User-written prediction strategies (runtime state, not config)
strategies.json

# Testing / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
