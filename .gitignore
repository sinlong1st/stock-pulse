# Environment / secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Databases
*.db
*.sqlite
*.sqlite3
stockpulse.db

# Local config files (edit the .json; commit the .example.json templates).
# Anchored to the repo root on purpose: unanchored, these match at ANY depth and
# silently swallowed tests/fixtures/watchlist.json, which must be committed for
# CI to pass. Docker mounts both from the root (see docker-compose.yml).
/watchlist.json
/keywords.json

# Briefing rolling theme memory (runtime state, not config)
briefing_memory.json

# Runtime user prefs, e.g. the /language choice (runtime state, not config)
runtime_prefs.json

# Registered push notification tokens (runtime state, not config)
push_tokens.json

# User-written prediction strategies (runtime state, not config)
strategies.json

# Saved holdings for the Exit Advisor (runtime state, and personal financial
# data — this repo is public). Anchored, like watchlist/keywords; the Docker
# copy lives under data/, which is ignored wholesale just below.
/positions.json

# The Docker volume (docker-compose mounts ./data:/app/data). Everything the
# running service writes lands here: the database, runtime prefs, push tokens,
# strategies, positions. None of it is config and some of it is personal, so the
# whole directory is ignored explicitly — it used to be covered only as a side
# effect of the unanchored patterns above matching at any depth, which is not a
# protection worth resting personal data on.
#
# ANCHORED, and it has to stay that way: a bare `data/` matches a directory of
# that name at ANY depth, which silently swallowed `mobile/src/data/` — the
# app's entire API layer. Same trap as the unanchored `watchlist.json` that
# swallowed the CI fixture.
/data/

# Testing / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
